# ─── Client (Vite) — safe to expose; never put API secrets here ───
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID_PRO_MONTHLY=
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CUSTOMER_PORTAL_URL=
# Show Free/trial/Pro mock switcher in settings (also on when DEV or Paddle not configured)
VITE_ALLOW_MOCK_SUB=true

# ─── Server (Vercel) — never prefix with VITE_ ───
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
